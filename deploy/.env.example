# Скопируйте в deploy/.env и заполните. Файл .env в git не попадает.
DOMAIN=quant.example.com
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
GRAFANA_PASSWORD=change-me

QUANT_SESSION_SECRET=change-me-long-random
QUANT_WEB_BASE_URL=https://quant.example.com

# Telegram: токен бота и whitelist chat_id через запятую; канал — опционально
QUANT_TELEGRAM_TOKEN=
QUANT_TELEGRAM_CHAT_IDS=
QUANT_TELEGRAM_CHANNEL_ID=
QUANT_QUIET_HOURS_UTC=

# Бэкапы ClickHouse в S3
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
